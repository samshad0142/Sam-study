<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
 <application android:theme="@style/AppTheme" android:label="@string/app_name" android:allowBackup="false">
  <activity android:name=".LockActivity" android:exported="false"/>
  <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <service android:name=".StudyShieldAccessibilityService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="false">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/studyshield_accessibility"/>
  </service>
 </application>
</manifest>